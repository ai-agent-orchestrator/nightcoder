%%{init: {"flowchart": {"rankSpacing": 30, "nodeSpacing": 26}}}%%
flowchart TB
    Client["Client / Tablet / Scheduler<br/>signed internal token: tenant, session, role"]
    Orch["Python FastAPI Orchestrator<br/>dispatch, concurrency, per-tenant budget"]
    SlotA["Cost slot A (ours)<br/>Credit wallet: reserve credits"]
    InGuard["Input guard (ours)<br/>rate limit, Dynamic Guard score + lock,<br/>distributed injection, Unicode normalization, masking"]
    NeMoIn["NVIDIA NeMo Guardrails<br/>optional 2nd layer: input rails"]
    Queue["Task Queue<br/>bounded jobs, retries, usage-limit cooldown"]
    Sandbox["Agent gates (ours)<br/>worktree, diff guard, remote check,<br/>test re-run, rollback"]
    W1["Meta Llama worker<br/>extract and tag"]
    W2["Meta Llama worker<br/>summarize"]
    W3["Cloud brain<br/>reasoning, drafts"]
    LLM["GuardedLLM (ours)<br/>every model call: reserve, call, settle"]
    OutGuard["Output guard (ours)<br/>canary leak, extraction budget,<br/>8-gram copy ratio, hallucinated source removal"]
    NeMoOut["NVIDIA NeMo Guardrails<br/>optional 2nd layer: output rails"]
    SlotB["Cost slot B (ours)<br/>settle actual usage, monthly cap, never negative"]
    Acct["Validation and Usage Accounting (ours)<br/>hash-only audit, funnel / ROI, tenant /metrics"]
    Review["Stop / Defer<br/>record status for review"]

    Client --> Orch --> SlotA --> InGuard
    InGuard -->|"allowed"| NeMoIn
    InGuard -->|"blocked"| Review
    NeMoIn -.->|"allowed"| Queue
    InGuard -.->|"NeMo off"| Queue
    Queue --> W1 & W2 & W3
    Queue -.->|"agent tasks only"| Sandbox -.-> W2
    W1 & W2 & W3 --> LLM --> OutGuard
    OutGuard -->|"allowed"| NeMoOut -.-> SlotB
    OutGuard -.->|"NeMo off"| SlotB
    OutGuard -->|"blocked"| Review
    SlotB --> Acct

