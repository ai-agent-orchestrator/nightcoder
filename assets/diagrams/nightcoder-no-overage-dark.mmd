flowchart TB
    W["Start wizard<br/>pick model from menu, enter remaining %,<br/>reset time, deadline"] --> P["Plan per lane<br/>what fits before limits and deadline"]
    P --> E["Clean environment<br/>all API keys stripped"]
    E --> S{"Subscription login?<br/>no api-key / billing flags"}
    S -->|"no"| X["coder disabled"]
    S -->|"yes"| R["Run spec<br/>stdin closed: nothing can confirm a purchase"]
    R --> B{"Before next spec:<br/>remaining - margin >= cost?"}
    B -->|"no, reset before deadline"| WAIT["wait for reset"]
    B -->|"no, deadline"| STOP["stop early, clean"]
    B -->|"yes"| R
    R -.->|"purchase / upgrade text<br/>or a browser opened by the coder"| K["kill coder tree<br/>roll back, lane stopped"]
    K --> OFF["screen off, kept off while idle<br/>never locks the PC"]
    CAP["Hard caps per day<br/>no override flag"] -.-> R
    class W,P result
    class E,S,R,B ours
    class X,STOP,WAIT control
    class K,OFF stop
    class CAP control
